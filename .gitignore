# Секреты — реальные .env с значениями НИКОГДА не коммитим.
.env
*.env
# ...но шаблон .env.example (без значений) — наоборот, должен быть в git.
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
.vite/
*.local

# OS / IDE
.DS_Store
.idea/
.vscode/
.claude/*
# Проектные скиллы агента — часть репозитория (см. docs/TASK_PROTOCOL.md).
!.claude/skills/

# TLS-серты (self-signed локально / боевые на сервере) — никогда в git.
docker/nginx/certs/
docker/nginx-staging/certs/

# dev.sh — PID-файлы и логи локального окружения
.dev/

# Playwright MCP: вывод (скриншоты, снапшоты, console-логи) уводится в
# ~/.cache/playwright-mcp через --output-dir. Строка — страховка на случай
# машины/агента без этой настройки: визуальная проверка UI не оставляет следов в репо.
.playwright-mcp/
# Скриншоты ручной проверки — в скретчпад, а не в корень репозитория.
/*.png

# Массовое заведение аккаунтов — выгрузка логинов/паролей (секреты) и список ников.
credentials_*.txt
users.md
/OldBot/*