# Скопировать в .env и заполнить. .env в .gitignore — НИКОГДА не коммитить.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=platform
# Хост = имя сервиса в docker-сети. Если backend запущен на хосте против контейнеров,
# заменить postgres -> localhost.
DATABASE_URL=postgresql+asyncpg://app:change_me@postgres:5432/platform

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-совместимо) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_too
MINIO_ENDPOINT=http://minio:9000
# Адрес MinIO, доступный браузеру (для presigned URL). Внутри docker — minio:9000,
# но клиент-браузер ходит на host. В dev — localhost:9000. Если пусто, берётся MINIO_ENDPOINT.
# В ПРОДЕ presigned-URL подписываются под публичным медиа-доменом за nginx:
#   MINIO_PUBLIC_ENDPOINT=https://${MEDIA_DOMAIN}
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_MEDIA=chat-media
MINIO_BUCKET_KB=kb-media
# Максимальный размер загружаемого файла в байтах (по умолчанию 5 ГБ — под видео).
MEDIA_MAX_UPLOAD_BYTES=5368709120

# --- JWT ---
# Сгенерировать длинный случайный секрет, напр.: openssl rand -hex 32
JWT_SECRET=replace_with_long_random_secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Деплой / nginx (prod) ---
# Основной домен (SPA + /api + /ws) и медиа-домен (presigned MinIO за nginx).
# Локальная проверка прод-стека: DOMAIN=localhost, MEDIA_DOMAIN=media.localhost.
# В проде — реальные домены (под них же выписываются TLS-серты).
DOMAIN=localhost
MEDIA_DOMAIN=media.localhost
# Поддомен тестового стенда (staging) — прод-nginx проксирует его внутрь отдельного
# compose-проекта platform-staging через сеть `gateway` (см. docs/DEPLOY.md → Staging).
# Нужен только на проде; своего docker-compose.staging.yml/.env это НЕ касается.
STAGING_DOMAIN=staging.argonautica-systems.ru
# Поддомен Grafana (docker-compose.observability.yml) — прод-nginx проксирует его в
# сервис grafana с basic auth (htpasswd, не в репо, см. docs/DEPLOY.md «Наблюдаемость»).
METRICS_DOMAIN=metrics.argonautica-systems.ru
# Пароль встроенного admin-пользователя Grafana (вторая линия защиты, первая — basic
# auth в nginx). Сгенерировать: openssl rand -base64 18.
GRAFANA_ADMIN_PASSWORD=change_me_too
# Число uvicorn-воркеров в контейнере backend (realtime поверх Redis pub/sub — безопасно).
UVICORN_WORKERS=2

# --- Telegram-бот выдачи доступа (scripts/telegram_bot.py, HTTP Bot API) ---
# Токен бота от @BotFather. Если пусто — сервис bot просто не поднимать.
TELEGRAM_BOT_TOKEN=
# Публичный адрес платформы (в сообщениях бота и инструкции по установке PWA).
PLATFORM_URL=https://platform.argonautica-systems.ru
# Прокси для доступа к Telegram, если IP Telegram заблокированы на сервере (частый
# случай на RU-хостинге). Формат: socks5://user:pass@host:port или http://host:port.
# Пусто — прямое подключение.
TELEGRAM_PROXY=
# Личка админа (твой chat_id) — сюда бот шлёт лог действий («@user получил пароль»)
# и техвопросы пользователей. Ответ reply на пересланный вопрос доставляется обратно
# пользователю. Узнать свой id: написать боту @userinfobot. Пусто — лог только в stdout,
# техвопросы принимаются, но не пересылаются.
TELEGRAM_ADMIN_CHAT_ID=

# --- Бот-воронка приёма и оплаты (scripts/intake_bot.py, ARG-92) ---
# СВОЙ токен от @BotFather (не TELEGRAM_BOT_TOKEN выше) — свой getUpdates-поллер,
# поэтому, в отличие от access-бота, живёт и на стенде (docker-compose.staging.yml).
TELEGRAM_INTAKE_BOT_TOKEN=
# Личка автора задачи (не групповой чат) — сюда уходят анкеты, чеки и техвопросы.
# Узнать chat_id: написать этому боту /start первым, посмотреть в docker logs.
TELEGRAM_INTAKE_BOT_ADMIN_CHAT_ID=
# TELEGRAM_PROXY переиспользуется из блока access-бота выше.
# PLATFORM_URL переиспользуется из блока access-бота выше — на стенде укажи
# https://staging.argonautica-systems.ru, чтобы ссылка в сообщении с логином/паролем
# вела на правильный домен.
