{
  "permissions": {
    "deny": [
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make up-test:*)",
      "Bash(make down-test:*)",
      "Bash(make migrate-test:*)",
      "Bash(make local-:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(alembic:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(tsc:*)",
      "Bash(vite:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(docker run:*)",
      "mcp__playwright__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-local-checks.py\"" }
        ]
      }
    ]
  }
}
